# ==============================================================================
# GlucoTwin Root Git Ignore Rules
# ==============================================================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Frontend Dependencies & Build Output
node_modules/
dist/
dist-ssr/
frontend/dist/
.oxlint-cache/

# Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Local Secrets
# Keep example templates tracked for onboarding
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.*.example

# Local SQLite Database Files (reproducible via seed.py)
*.db
*.sqlite
*.sqlite3

# Operating System & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
