# =============================================================================
# GlucoTwin Backend Configuration (.env.example)
# =============================================================================
# Copy this template to .env for local development or set these variables
# in your cloud deployment platform (e.g., Render, Vercel, AWS ECS, Fly.io).
# Never commit real secrets or production credentials to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Mode
# -----------------------------------------------------------------------------
# Options: 'development', 'staging', 'production'
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 2. Authentication & JWT Security
# -----------------------------------------------------------------------------
# CRITICAL: In production, generate a cryptographically strong 256-bit secret:
# python -c "import secrets; print(secrets.token_hex(32))"
GLUCOTWIN_JWT_SECRET=change-this-in-production-use-a-strong-random-hex-string-2026
GLUCOTWIN_JWT_ALGORITHM=HS256
GLUCOTWIN_ACCESS_TOKEN_EXPIRE_MINUTES=180

# -----------------------------------------------------------------------------
# 3. Persistent Document Storage
# -----------------------------------------------------------------------------
# Storage Provider Options:
#   - 'local'           : Local filesystem storage (development default).
#   - 'persistent_disk' : Persistent disk mount path (e.g. Render Disk).
#   - 's3'              : S3-compatible private object storage (AWS, Cloudflare R2, MinIO).
GLUCOTWIN_STORAGE_PROVIDER=local

# Local / Persistent Disk mount directory (required if running local/persistent_disk in production):
GLUCOTWIN_UPLOAD_DIR=./uploads

# S3 Object Storage Configuration (required if GLUCOTWIN_STORAGE_PROVIDER='s3'):
GLUCOTWIN_S3_BUCKET=my-glucotwin-medical-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional Custom S3 Endpoint (for Cloudflare R2, MinIO, or Wasabi):
# GLUCOTWIN_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# 4. CORS Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of additional frontend origins allowed to contact the API:
ALLOWED_ORIGINS=https://gluco-twin-eta.vercel.app,http://localhost:5173,http://127.0.0.1:5173
